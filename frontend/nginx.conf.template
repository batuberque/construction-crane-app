server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Cloud Run terminates TLS at the edge but does not compress for us.
  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options "nosniff" always;

  # Vite emits only content-hashed filenames here, so this is safe to pin forever.
  # Nothing from public/ may be placed under /assets/.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  # public/ files (favicon, hero-*.webp) are not hashed, so only a short TTL.
  location / {
    add_header Cache-Control "public, max-age=3600";
    try_files $uri $uri/ /index.html;
  }
}
